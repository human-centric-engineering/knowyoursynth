  "depths": {},
  "hears": {
    "j.modSrc": {
      "lfo@init": "The LFO takes the place of noise as the right-hand source of the mod bus. From there MOD MIX, MOD DEPTH (plus the mod wheel) and the OSCILLATOR and FILTER MODULATION switches decide how much of it reaches the pitch and the cutoff, exactly as they do for noise.",
      "audio@init": "Oscillator 1 takes the place of noise as the right-hand source of the mod bus. From there MOD MIX, MOD DEPTH (plus the mod wheel) and the OSCILLATOR and FILTER MODULATION switches decide how much of it reaches the pitch and the cutoff, exactly as they do for noise.",
      "noise@init": "The noise generator takes the place of noise as the right-hand source of the mod bus. From there MOD MIX, MOD DEPTH (plus the mod wheel) and the OSCILLATOR and FILTER MODULATION switches decide how much of it reaches the pitch and the cutoff, exactly as they do for noise.",
      "fast@init": "The fast LFO takes the place of noise as the right-hand source of the mod bus. From there MOD MIX, MOD DEPTH (plus the mod wheel) and the OSCILLATOR and FILTER MODULATION switches decide how much of it reaches the pitch and the cutoff, exactly as they do for noise.",
      "env@init": "The envelope takes the place of noise as the right-hand source of the mod bus. From there MOD MIX, MOD DEPTH (plus the mod wheel) and the OSCILLATOR and FILTER MODULATION switches decide how much of it reaches the pitch and the cutoff, exactly as they do for noise.",
      "kbd@init": "The keyboard pitch takes the place of noise as the right-hand source of the mod bus. From there MOD MIX, MOD DEPTH (plus the mod wheel) and the OSCILLATOR and FILTER MODULATION switches decide how much of it reaches the pitch and the cutoff, exactly as they do for noise.",
      "kbd2@init": "The upper voice takes the place of noise as the right-hand source of the mod bus. From there MOD MIX, MOD DEPTH (plus the mod wheel) and the OSCILLATOR and FILTER MODULATION switches decide how much of it reaches the pitch and the cutoff, exactly as they do for noise."
    }
  }
