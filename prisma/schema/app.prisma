// Fork-owned schema file — reserved for YOUR app's models.
//
// Sunrise ships this file empty and never adds models to it, the same way it
// keeps `lib/app/**` and `.context/app/` empty, so a fork's models here merge
// cleanly on every upstream sync. Sunrise's own app-domain models
// (ContactSubmission, FeatureFlag, AuthBootstrap) live in `platform.prisma`.
//
// The schema is multi-file (`prisma.config.ts` → `schema: 'prisma/schema'`), so
// every `.prisma` file in this folder is loaded — just add models below.
//
// See CUSTOMIZATION.md §5 for the FK/onDelete rules a model with a `userId`
// must follow (GDPR erasure depends on them).

// ─── Catalogue (f-model-d, plan §9) ─────────────────────────────────────────
//
// Product content every org shares: on GLOBAL_CONFIG_MODELS in
// lib/tenancy/classification.ts (divergence row in .context/app/divergences.md).
// No row has a user foreign key, so none is on the export manifest.
//
// Seeded from prisma/seeds/app-knowyoursynth/data/ by `001-catalogue.ts`. After
// the first seed the tables are the source of truth (D2, D13): a row whose
// `editedAt` is set has been changed by an admin, and the seed never writes it
// again. The seed never deletes a row either.

/// A synth in the catalogue. The id is its definition's key in the registry
/// (`lib/app/synths/defs/`); the descriptive columns start as the definition's
/// and are the admin's after that. The definition's version is not copied
/// here: the registry is the only place it lives.
model Synth {
  id        String    @id // e.g. "model-d"
  name      String
  maker     String
  year      Int
  heritage  String
  summary   String    @db.Text
  /// Shown in the public catalogue.
  listed    Boolean   @default(true)
  /// Position in the catalogue, lowest first.
  order     Int
  /// Set when an admin changes the row; the seed then leaves it alone.
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Which design the panel draws (D11). The seed never writes these columns, and changing them does not set
  /// `editedAt`: they are not the descriptive content the seed reconciles.
  design             PanelDesign @default(NEUTRAL)
  /// The maker's approval to show their marks: who gave it (the vendor-side person, not a user of this app), when, and
  /// a note or a reference to the correspondence. Required before `design` is FAITHFUL; kept when it goes back to
  /// NEUTRAL. The admin who recorded it is in the audit log.
  designApprovedBy   String?
  designApprovedAt   DateTime?
  designApprovalNote String?     @db.Text

  sounds  SynthSound[]
  lineage SynthLineage?
  notes   SynthNote[]

  /// Databank instruments this synth models, and record parts listed under it.
  bankInstruments BankInstrumentSynth[]
  bankParts       BankPartSynth[]

  @@index([listed, order])
  @@map("synth")
}

enum PanelDesign {
  /// The synth's own panel without the maker's logos, wordmarks and badges. The default.
  NEUTRAL
  /// The panel as the hardware looks, maker's marks included. Needs a recorded approval.
  FAITHFUL
}

/// A library sound, built step by step on top of the synth's init patch
/// (`Preset` in lib/app/synths/contract.ts). Validated against its definition
/// version by lib/app/synths/validate.ts on write and on read.
model SynthSound {
  id                String    @id @default(cuid())
  synthId           String
  /// The sound's id within its synth, e.g. "stacked-night-bass".
  slug              String
  /// The definition version the sound was made on.
  definitionVersion Int
  name              String
  /// `In the style of <artist> — "<work>"`.
  ref               String
  artist            String
  /// First tag is the category.
  tags              String[]
  /// 1 beginner · 2 intermediate · 3 advanced.
  level             Int
  blurb             String    @db.Text
  how               String    @db.Text
  /// `Phrase`: the riff that shows the sound off.
  phrase            Json
  /// `PresetStep[]`: the lesson, and the panel values and cables it sets.
  steps             Json
  /// Control id → what that control does in this sound.
  context           Json
  /// `PresetTweak[]`.
  tweaks            Json
  /// Position in the synth's library, lowest first.
  order             Int
  editedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  synth Synth @relation(fields: [synthId], references: [id], onDelete: Cascade)

  @@unique([synthId, slug])
  @@index([synthId, order])
  @@map("synth_sound")
}

/// A synth's history section (`Lineage` in the contract, less "Heard on",
/// which comes from the databank).
model SynthLineage {
  synthId   String    @id
  title     String
  intro     String    @db.Text
  /// `LineageEntry[]`.
  timeline  Json
  /// `LineageRelative[]`.
  relatives Json
  users     String[]
  note      String?   @db.Text
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  synth Synth @relation(fields: [synthId], references: [id], onDelete: Cascade)

  @@map("synth_lineage")
}

enum SynthNoteKind {
  /// "Unusual on…": how this synth names or does a thing differently. `target` is a control, jack or area id.
  UNUSUAL
  /// The opening sentence of a synth's "What is not modelled" list.
  LIMIT_INTRO
  /// One "What is not modelled" entry, with a title. No synth: true of every panel.
  LIMIT
}

/// A short note about a synth, or (with no synth) about every panel.
model SynthNote {
  id        String        @id @default(cuid())
  /// Stable natural key the seed matches on, e.g. "model-d/unusual/mod.mix".
  key       String        @unique
  kind      SynthNoteKind
  /// Null for a limit shared by every panel.
  synthId   String?
  /// The control, jack or area an UNUSUAL note is about.
  target    String?
  title     String?
  text      String        @db.Text
  order     Int
  editedAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  synth Synth? @relation(fields: [synthId], references: [id], onDelete: Cascade)

  @@index([synthId, kind, order])
  @@map("synth_note")
}

enum CatalogueTable {
  SYNTH
  SOUND
  LINEAGE
  NOTE
}

/// What the seed last planned for one catalogue row: the content it would write, placement left out. Written by the
/// seed alone, on every run, so the admin data page (`lib/app/catalogue/reconcile.ts`) can say whether a row matches
/// the seed without the app reading the seed files (D13). The seed writes a record only when its values change, and
/// removes the records of rows the data no longer has. No foreign key: a record describes the seed, not the table, and
/// may name a row the table does not have yet.
model CatalogueSeedRecord {
  table     CatalogueTable
  /// The row's natural key: the synth id, `<synthId>/<slug>` for a sound, the synth id for lineage, a note's `key`.
  key       String
  /// The synth the row belongs to; null for a limit shared by every panel.
  synthId   String?
  /// The columns the seed planned, as it would write them.
  values    Json
  createdAt DateTime       @default(now())
  /// When the seed last planned different values for the row.
  updatedAt DateTime       @updatedAt

  @@id([table, key])
  @@index([synthId])
  @@map("catalogue_seed_record")
}

// ─── Databank (f-databank, plan §9) ──────────────────────────────────────────
//
// The artists, records, instruments and the people who built them, joined by id
// (`Databank` in prototype/CONTRACT.md). Product content every org shares, so on
// GLOBAL_CONFIG_MODELS beside the catalogue; no row has a user foreign key.
//
// Seeded from prisma/seeds/app-knowyoursynth/data/bank/ by `002-bank.ts`, with
// the catalogue's rules (lib/app/bank/seed.ts): checked first, idempotent, an
// `editedAt` row is the admin's and never written again, and no row is deleted.
// A join belongs to the row that lists it, so the seed rewrites a row's joins
// only while that row is the seed's. A reference to another row is `Restrict`:
// a row something points at cannot be removed until the reference is gone.
//
// The vocabularies (`kind`) are text checked by lib/app/bank/data.ts, so a new
// kind is a code change, not a migration.

/// A designer, engineer or founder ("Innovators"). What they made is read from
/// the instruments that list them.
model BankMaker {
  id          String    @id // e.g. "robert-moog"
  name        String
  born        String?
  died        String?
  country     String
  companies   String[]
  summary     String    @db.Text
  story       String    @db.Text
  innovations String[]
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  instruments BankInstrumentPerson[]

  @@map("bank_maker")
}

/// A real instrument: one named on records, an original a panel is modelled
/// on, or (from b4) any synth that exists.
model BankInstrument {
  id             String    @id // e.g. "moog-minimoog"
  name           String
  /// The company, as text.
  maker          String
  /// A year or range, as text ("1970", "1980s").
  year           String
  kind           String
  text           String    @db.Text
  /// The original this one recreates (a Behringer Model D → the Minimoog).
  recreationOfId String?
  editedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  recreationOf BankInstrument?        @relation("BankRecreation", fields: [recreationOfId], references: [id], onDelete: Restrict)
  recreations  BankInstrument[]       @relation("BankRecreation")
  people       BankInstrumentPerson[]
  synths       BankInstrumentSynth[]
  parts        BankPartInstrument[]
  artists      BankArtistInstrument[]

  @@index([recreationOfId])
  @@map("bank_instrument")
}

/// The people behind an instrument, in the order it lists them.
model BankInstrumentPerson {
  instrumentId String
  makerId      String
  order        Int

  instrument BankInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  maker      BankMaker      @relation(fields: [makerId], references: [id], onDelete: Restrict)

  @@id([instrumentId, makerId])
  @@index([makerId])
  @@map("bank_instrument_person")
}

/// An app synth that models an instrument (`app` in the contract). Records
/// made on the instrument show in that synth's "Heard on" list.
model BankInstrumentSynth {
  instrumentId String
  synthId      String

  instrument BankInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  synth      Synth          @relation(fields: [synthId], references: [id], onDelete: Restrict)

  @@id([instrumentId, synthId])
  @@index([synthId])
  @@map("bank_instrument_synth")
}

/// A player, band, producer, composer or sound designer.
model BankArtist {
  id          String    @id // e.g. "aphex-twin"
  name        String
  /// person | group
  kind        String
  country     String
  active      String
  eras        String[]
  genres      String[]
  roles       String[]
  summary     String    @db.Text
  story       String    @db.Text
  innovations String[]
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members     BankArtistMember[]     @relation("BankGroup")
  groups      BankArtistMember[]     @relation("BankMember")
  instruments BankArtistInstrument[]
  songs       BankSongArtist[]
  playedParts BankSongPart[]

  @@map("bank_artist")
}

/// A member of a group. The group lists its members, so the row is the
/// group's. The prototype recorded membership on either side (`members`,
/// `memberOf`); both become rows here.
model BankArtistMember {
  groupId  String
  memberId String
  order    Int

  group  BankArtist @relation("BankGroup", fields: [groupId], references: [id], onDelete: Cascade)
  member BankArtist @relation("BankMember", fields: [memberId], references: [id], onDelete: Restrict)

  @@id([groupId, memberId])
  @@index([memberId])
  @@map("bank_artist_member")
}

/// An instrument an artist is known to have used beyond their records.
model BankArtistInstrument {
  artistId     String
  instrumentId String
  order        Int

  artist     BankArtist     @relation(fields: [artistId], references: [id], onDelete: Cascade)
  instrument BankInstrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  @@id([artistId, instrumentId])
  @@index([instrumentId])
  @@map("bank_artist_instrument")
}

/// A song, album, score, performance or body of work.
model BankSong {
  id        String    @id
  title     String
  /// song | album | score | body | performance
  kind      String
  year      String?
  album     String?
  /// The printed credit, when the names alone lose something.
  credit    String?
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  artists BankSongArtist[]
  parts   BankSongPart[]

  @@map("bank_song")
}

/// A work's credited artists, in credit order.
model BankSongArtist {
  songId   String
  artistId String
  order    Int

  song   BankSong   @relation(fields: [songId], references: [id], onDelete: Cascade)
  artist BankArtist @relation(fields: [artistId], references: [id], onDelete: Restrict)

  @@id([songId, artistId])
  @@index([artistId])
  @@map("bank_song_artist")
}

/// What a synth plays on a work.
model BankSongPart {
  id       String  @id @default(cuid())
  songId   String
  order    Int
  /// The real instrument, as printed ("Roland Jupiter-8 (the lead), with …").
  on       String
  text     String  @db.Text
  playerId String?

  song        BankSong             @relation(fields: [songId], references: [id], onDelete: Cascade)
  player      BankArtist?          @relation(fields: [playerId], references: [id], onDelete: Restrict)
  instruments BankPartInstrument[]
  synths      BankPartSynth[]

  @@unique([songId, order])
  @@index([playerId])
  @@map("bank_song_part")
}

/// An instrument a part is played on, in the order the part lists them.
model BankPartInstrument {
  partId       String
  instrumentId String
  order        Int

  part       BankSongPart   @relation(fields: [partId], references: [id], onDelete: Cascade)
  instrument BankInstrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  @@id([partId, instrumentId])
  @@index([instrumentId])
  @@map("bank_part_instrument")
}

/// What a part says about one app synth: listed under it by hand (`synths`),
/// a library sound in its style (`sounds`), or its own text there (`notes`).
model BankPartSynth {
  partId  String
  synthId String
  /// Listed in this synth's "Heard on" whatever its instruments.
  listed  Boolean
  /// The slug of a library sound on this synth, checked by the seed.
  sound   String?
  /// Shown in this synth's list in place of the part's text.
  note    String? @db.Text

  part  BankSongPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  synth Synth        @relation(fields: [synthId], references: [id], onDelete: Restrict)

  @@id([partId, synthId])
  @@index([synthId])
  @@map("bank_part_synth")
}

/// A databank row an admin removed (`f-databank` t-36). The seed re-creates a
/// row it does not find, so it reads these and leaves the row out. Saving a row
/// with the same kind and id again deletes the record.
model BankRemoval {
  /// The API's kind: makers | instruments | artists | songs
  kind      String
  id        String
  removedAt DateTime @default(now())

  @@id([kind, id])
  @@map("bank_removal")
}
