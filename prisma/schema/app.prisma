// Fork-owned schema file — reserved for YOUR app's models.
//
// Sunrise ships this file empty and never adds models to it, the same way it
// keeps `lib/app/**` and `.context/app/` empty, so a fork's models here merge
// cleanly on every upstream sync. Sunrise's own app-domain models
// (ContactSubmission, FeatureFlag, AuthBootstrap) live in `platform.prisma`.
//
// The schema is multi-file (`prisma.config.ts` → `schema: 'prisma/schema'`), so
// every `.prisma` file in this folder is loaded — just add models below.
//
// See CUSTOMIZATION.md §5 for the FK/onDelete rules a model with a `userId`
// must follow (GDPR erasure depends on them).

// ─── Catalogue (f-model-d, plan §9) ─────────────────────────────────────────
//
// Product content every org shares: on GLOBAL_CONFIG_MODELS in
// lib/tenancy/classification.ts (divergence row in .context/app/divergences.md).
// No row has a user foreign key, so none is on the export manifest.
//
// Seeded from prisma/seeds/app-knowyoursynth/data/ by `001-catalogue.ts`. After
// the first seed the tables are the source of truth (D2, D13): a row whose
// `editedAt` is set has been changed by an admin, and the seed never writes it
// again. The seed never deletes a row either.

/// A synth in the catalogue. The id is its definition's key in the registry
/// (`lib/app/synths/defs/`); the descriptive columns start as the definition's
/// and are the admin's after that. The definition's version is not copied
/// here: the registry is the only place it lives.
model Synth {
  id        String    @id // e.g. "model-d"
  name      String
  maker     String
  year      Int
  heritage  String
  summary   String    @db.Text
  /// Shown in the public catalogue.
  listed    Boolean   @default(true)
  /// Position in the catalogue, lowest first.
  order     Int
  /// Set when an admin changes the row; the seed then leaves it alone.
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Which design the panel draws (D11). The seed never writes these columns, and changing them does not set
  /// `editedAt`: they are not the descriptive content the seed reconciles.
  design             PanelDesign @default(NEUTRAL)
  /// The maker's approval to show their marks: who gave it (the vendor-side person, not a user of this app), when, and
  /// a note or a reference to the correspondence. Required before `design` is FAITHFUL; kept when it goes back to
  /// NEUTRAL. The admin who recorded it is in the audit log.
  designApprovedBy   String?
  designApprovedAt   DateTime?
  designApprovalNote String?     @db.Text

  sounds     SynthSound[]
  lineage    SynthLineage?
  notes      SynthNote[]
  userSounds UserSound[]
  /// Signed-in users' last panel on this synth.
  panelPrefs SynthPreference[]
  /// Users who starred this synth.
  favourites Favourite[]

  /// Databank instruments this synth models, and record parts listed under it.
  bankInstruments BankInstrumentSynth[]
  bankParts       BankPartSynth[]

  @@index([listed, order])
  @@map("synth")
}

enum PanelDesign {
  /// The synth's own panel without the maker's logos, wordmarks and badges. The default.
  NEUTRAL
  /// The panel as the hardware looks, maker's marks included. Needs a recorded approval.
  FAITHFUL
}

/// A library sound, built step by step on top of the synth's init patch
/// (`Preset` in lib/app/synths/contract.ts). Validated against its definition
/// version by lib/app/synths/validate.ts on write and on read.
model SynthSound {
  id                String    @id @default(cuid())
  synthId           String
  /// The sound's id within its synth, e.g. "stacked-night-bass".
  slug              String
  /// The definition version the sound was made on.
  definitionVersion Int
  name              String
  /// `In the style of <artist> — "<work>"`.
  ref               String
  artist            String
  /// First tag is the category.
  tags              String[]
  /// 1 beginner · 2 intermediate · 3 advanced.
  level             Int
  blurb             String    @db.Text
  how               String    @db.Text
  /// `Phrase`: the riff that shows the sound off.
  phrase            Json
  /// `PresetStep[]`: the lesson, and the panel values and cables it sets.
  steps             Json
  /// Control id → what that control does in this sound.
  context           Json
  /// `PresetTweak[]`.
  tweaks            Json
  /// Position in the synth's library, lowest first.
  order             Int
  editedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  synth Synth @relation(fields: [synthId], references: [id], onDelete: Cascade)

  /// Users' sounds copied from this one.
  copies     UserSound[]
  /// Users' progress through this sound's lesson, and users who starred it.
  progress   LessonProgress[]
  favourites Favourite[]

  @@unique([synthId, slug])
  @@index([synthId, order])
  @@map("synth_sound")
}

/// A synth's history section (`Lineage` in the contract, less "Heard on",
/// which comes from the databank).
model SynthLineage {
  synthId   String    @id
  title     String
  intro     String    @db.Text
  /// `LineageEntry[]`.
  timeline  Json
  /// `LineageRelative[]`.
  relatives Json
  users     String[]
  note      String?   @db.Text
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  synth Synth @relation(fields: [synthId], references: [id], onDelete: Cascade)

  @@map("synth_lineage")
}

enum SynthNoteKind {
  /// "Unusual on…": how this synth names or does a thing differently. `target` is a control, jack or area id.
  UNUSUAL
  /// The opening sentence of a synth's "What is not modelled" list.
  LIMIT_INTRO
  /// One "What is not modelled" entry, with a title. No synth: true of every panel.
  LIMIT
}

/// A short note about a synth, or (with no synth) about every panel.
model SynthNote {
  id        String        @id @default(cuid())
  /// Stable natural key the seed matches on, e.g. "model-d/unusual/mod.mix".
  key       String        @unique
  kind      SynthNoteKind
  /// Null for a limit shared by every panel.
  synthId   String?
  /// The control, jack or area an UNUSUAL note is about.
  target    String?
  title     String?
  text      String        @db.Text
  order     Int
  editedAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  synth Synth? @relation(fields: [synthId], references: [id], onDelete: Cascade)

  @@index([synthId, kind, order])
  @@map("synth_note")
}

enum CatalogueTable {
  SYNTH
  SOUND
  LINEAGE
  NOTE
}

/// What the seed last planned for one catalogue row: the content it would write, placement left out. Written by the
/// seed alone, on every run, so the admin data page (`lib/app/catalogue/reconcile.ts`) can say whether a row matches
/// the seed without the app reading the seed files (D13). The seed writes a record only when its values change, and
/// removes the records of rows the data no longer has. No foreign key: a record describes the seed, not the table, and
/// may name a row the table does not have yet.
model CatalogueSeedRecord {
  table     CatalogueTable
  /// The row's natural key: the synth id, `<synthId>/<slug>` for a sound, the synth id for lineage, a note's `key`.
  key       String
  /// The synth the row belongs to; null for a limit shared by every panel.
  synthId   String?
  /// The columns the seed planned, as it would write them.
  values    Json
  createdAt DateTime       @default(now())
  /// When the seed last planned different values for the row.
  updatedAt DateTime       @updatedAt

  @@id([table, key])
  @@index([synthId])
  @@map("catalogue_seed_record")
}

// ─── Databank (f-databank, plan §9) ──────────────────────────────────────────
//
// The artists, records, instruments and the people who built them, joined by id
// (`Databank` in prototype/CONTRACT.md). Product content every org shares, so on
// GLOBAL_CONFIG_MODELS beside the catalogue; no row has a user foreign key.
//
// Seeded from prisma/seeds/app-knowyoursynth/data/bank/ by `002-bank.ts`, with
// the catalogue's rules (lib/app/bank/seed.ts): checked first, idempotent, an
// `editedAt` row is the admin's and never written again, and no row is deleted.
// A join belongs to the row that lists it, so the seed rewrites a row's joins
// only while that row is the seed's. A reference to another row is `Restrict`:
// a row something points at cannot be removed until the reference is gone.
//
// The vocabularies (`kind`) are text checked by lib/app/bank/data.ts, so a new
// kind is a code change, not a migration.

/// A designer, engineer or founder ("Innovators"). What they made is read from
/// the instruments that list them.
model BankMaker {
  id          String    @id // e.g. "robert-moog"
  name        String
  born        String?
  died        String?
  country     String
  companies   String[]
  summary     String    @db.Text
  story       String    @db.Text
  innovations String[]
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  instruments BankInstrumentPerson[]

  @@map("bank_maker")
}

/// A real instrument: one named on records, an original a panel is modelled
/// on, or (from b4) any synth that exists.
model BankInstrument {
  id             String    @id // e.g. "moog-minimoog"
  name           String
  /// The company, as text.
  maker          String
  /// A year or range, as text ("1970", "1980s").
  year           String
  kind           String
  text           String    @db.Text
  /// Where its facts were checked: a URL. The reference list (b4) gives one for every entry.
  source         String?
  /// The original this one recreates (a Behringer Model D → the Minimoog).
  recreationOfId String?
  editedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  recreationOf BankInstrument?        @relation("BankRecreation", fields: [recreationOfId], references: [id], onDelete: Restrict)
  recreations  BankInstrument[]       @relation("BankRecreation")
  people       BankInstrumentPerson[]
  synths       BankInstrumentSynth[]
  parts        BankPartInstrument[]
  artists      BankArtistInstrument[]
  owners       OwnedInstrument[]

  @@index([recreationOfId])
  @@map("bank_instrument")
}

/// The people behind an instrument, in the order it lists them.
model BankInstrumentPerson {
  instrumentId String
  makerId      String
  order        Int

  instrument BankInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  maker      BankMaker      @relation(fields: [makerId], references: [id], onDelete: Restrict)

  @@id([instrumentId, makerId])
  @@index([makerId])
  @@map("bank_instrument_person")
}

/// An app synth that models an instrument (`app` in the contract). Records
/// made on the instrument show in that synth's "Heard on" list.
model BankInstrumentSynth {
  instrumentId String
  synthId      String

  instrument BankInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  synth      Synth          @relation(fields: [synthId], references: [id], onDelete: Restrict)

  @@id([instrumentId, synthId])
  @@index([synthId])
  @@map("bank_instrument_synth")
}

/// A player, band, producer, composer or sound designer.
model BankArtist {
  id          String    @id // e.g. "aphex-twin"
  name        String
  /// person | group
  kind        String
  country     String
  active      String
  eras        String[]
  genres      String[]
  roles       String[]
  summary     String    @db.Text
  story       String    @db.Text
  innovations String[]
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members     BankArtistMember[]     @relation("BankGroup")
  groups      BankArtistMember[]     @relation("BankMember")
  instruments BankArtistInstrument[]
  songs       BankSongArtist[]
  playedParts BankSongPart[]

  @@map("bank_artist")
}

/// A member of a group. The group lists its members, so the row is the
/// group's. The prototype recorded membership on either side (`members`,
/// `memberOf`); both become rows here.
model BankArtistMember {
  groupId  String
  memberId String
  order    Int

  group  BankArtist @relation("BankGroup", fields: [groupId], references: [id], onDelete: Cascade)
  member BankArtist @relation("BankMember", fields: [memberId], references: [id], onDelete: Restrict)

  @@id([groupId, memberId])
  @@index([memberId])
  @@map("bank_artist_member")
}

/// An instrument an artist is known to have used beyond their records.
model BankArtistInstrument {
  artistId     String
  instrumentId String
  order        Int

  artist     BankArtist     @relation(fields: [artistId], references: [id], onDelete: Cascade)
  instrument BankInstrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  @@id([artistId, instrumentId])
  @@index([instrumentId])
  @@map("bank_artist_instrument")
}

/// A song, album, score, performance or body of work.
model BankSong {
  id        String    @id
  title     String
  /// song | album | score | body | performance
  kind      String
  year      String?
  album     String?
  /// The printed credit, when the names alone lose something.
  credit    String?
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  artists BankSongArtist[]
  parts   BankSongPart[]

  @@map("bank_song")
}

/// A work's credited artists, in credit order.
model BankSongArtist {
  songId   String
  artistId String
  order    Int

  song   BankSong   @relation(fields: [songId], references: [id], onDelete: Cascade)
  artist BankArtist @relation(fields: [artistId], references: [id], onDelete: Restrict)

  @@id([songId, artistId])
  @@index([artistId])
  @@map("bank_song_artist")
}

/// What a synth plays on a work.
model BankSongPart {
  id       String  @id @default(cuid())
  songId   String
  order    Int
  /// The real instrument, as printed ("Roland Jupiter-8 (the lead), with …").
  on       String
  text     String  @db.Text
  playerId String?

  song        BankSong             @relation(fields: [songId], references: [id], onDelete: Cascade)
  player      BankArtist?          @relation(fields: [playerId], references: [id], onDelete: Restrict)
  instruments BankPartInstrument[]
  synths      BankPartSynth[]

  @@unique([songId, order])
  @@index([playerId])
  @@map("bank_song_part")
}

/// An instrument a part is played on, in the order the part lists them.
model BankPartInstrument {
  partId       String
  instrumentId String
  order        Int

  part       BankSongPart   @relation(fields: [partId], references: [id], onDelete: Cascade)
  instrument BankInstrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  @@id([partId, instrumentId])
  @@index([instrumentId])
  @@map("bank_part_instrument")
}

/// What a part says about one app synth: listed under it by hand (`synths`),
/// a library sound in its style (`sounds`), or its own text there (`notes`).
model BankPartSynth {
  partId  String
  synthId String
  /// Listed in this synth's "Heard on" whatever its instruments.
  listed  Boolean
  /// The slug of a library sound on this synth, checked by the seed.
  sound   String?
  /// Shown in this synth's list in place of the part's text.
  note    String? @db.Text

  part  BankSongPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  synth Synth        @relation(fields: [synthId], references: [id], onDelete: Restrict)

  @@id([partId, synthId])
  @@index([synthId])
  @@map("bank_part_synth")
}

/// A databank row an admin removed (`f-databank` t-36). The seed re-creates a
/// row it does not find, so it reads these and leaves the row out. Saving a row
/// with the same kind and id again deletes the record.
model BankRemoval {
  /// The API's kind: makers | instruments | artists | songs
  kind      String
  id        String
  removedAt DateTime @default(now())

  @@id([kind, id])
  @@map("bank_removal")
}

// ─── Synth suggestions (f-databank t-37) ─────────────────────────────────────
//
// A signed-in user's "this synth is missing", queued for an admin. Unlike the
// databank tables, a row is about a person: it carries the suggester's user id,
// so it is declared for subject export in lib/app/data-export.ts. On
// SYSTEM_MODELS beside ContactSubmission: an inbound queue, not a shared
// setting, decided by admins from one queue.
//
// `userId` is a plain string, not a @relation, so `User` (platform-owned) needs
// no back-relation field (CUSTOMIZATION.md §5). The FK is written by hand in the
// migration, `ON DELETE SET NULL`: an erased user's suggestion stays as databank
// history with nobody attached. A drift probe in lib/app/db-drift.ts pins it.

enum SynthSuggestionStatus {
  PENDING
  /// An admin created an instrument from it (`instrumentId`).
  ACCEPTED
  /// It was already in the databank, as `instrumentId`.
  MERGED
  /// Not added; `reason` says why.
  DECLINED
}

/// A synth a user says is missing from the databank.
model SynthSuggestion {
  id           String                @id @default(cuid())
  /// FK to User.id, ON DELETE SET NULL (hand-written in the migration).
  userId       String?
  name         String
  /// The company, as text, as BankInstrument.maker is.
  maker        String
  link         String?
  note         String?               @db.Text
  status       SynthSuggestionStatus @default(PENDING)
  /// The instrument it became (ACCEPTED) or was merged into (MERGED). Not a
  /// foreign key: it records the outcome, and does not stop the row's removal.
  instrumentId String?
  /// Why it was declined.
  reason       String?               @db.Text
  decidedAt    DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@map("synth_suggestion")
}

// ─── Users' sounds (f-my-sounds s1) ──────────────────────────────────────────
//
// A sound a user made on a synth: the panel they left, named and kept. A row is
// about a person, so it is declared for subject export in lib/app/data-export.ts.
// On SYSTEM_MODELS beside SynthSuggestion, with no orgId (owner ruling on
// f-my-sounds, 2026-10-15): a user's sounds are theirs in every org.
//
// `userId` is a plain string, as SynthSuggestion's is, so `User` needs no
// back-relation field. The FK is written by hand in the migration,
// `ON DELETE CASCADE`: erasing a user erases their sounds. A drift probe in
// lib/app/db-drift.ts pins it.

/// Who may open a user's sound (`f-sharing` h1). Only lib/app/sounds/publish.ts writes `published`.
enum SoundVisibility {
  /// Its owner only.
  private
  /// Anyone with its address, signed in or not. Not listed anywhere.
  link
  /// As `link`, and listed under its owner's username.
  published
}

/// A user's own sound: a panel state on one synth, validated against the synth's definition on write and on read
/// (lib/app/sounds/). Owner-scoped, unless its owner shares it (`f-sharing`, lib/app/sounds/sharing.ts).
model UserSound {
  id                String          @id @default(cuid())
  /// FK to User.id, ON DELETE CASCADE (hand-written in the migration).
  userId            String
  synthId           String
  /// The definition version the panel was saved on.
  definitionVersion Int
  name              String
  notes             String?         @db.Text
  /// `ControlValues`: control id → value.
  values            Json
  /// `CablePair[]`: `[outputJackId, inputJackId]`.
  cables            Json
  /// `SoundLesson` (lib/app/sounds/lesson.ts): how the sound works, the steps that build it, what each control does in
  /// it, things to try and a riff (`f-tutor` t-55). Null for a sound saved without one. Set when the sound is made, and
  /// after that only removed: saving a new panel over the sound leaves it as it was.
  lesson            Json?
  /// The definition version the lesson was checked against, set with it. Not `definitionVersion`, which a new panel
  /// moves on: a lesson waits for the mapping between versions (D1) until it is checked again.
  lessonVersion     Int?
  /// Whether the tutor designed it. A copy carries it, as it carries the lesson.
  fromTutor         Boolean         @default(false)
  /// The library sound it was copied from. Null for a sound made from scratch, and once that sound is removed.
  sourceSoundId     String?
  /// The credit, as the library sound read when it was copied, so it survives that sound being renamed or removed.
  sourceSlug        String?
  sourceName        String?
  /// `In the style of <artist> — "<work>"`.
  sourceRef         String?
  /// The shared sound it was copied from (`f-sharing` h1). Null for anything else, and once that sound is deleted or
  /// its owner erased. The credit is read through it while that sound is published, never kept, so it cannot outlive
  /// the erasure of the person it names.
  sourceUserSoundId String?
  visibility        SoundVisibility @default(private)
  /// Its public address, `/synths/<synthId>/s/<slug>`. Minted the first time it leaves private and kept after, so a
  /// link that stopped working when the sound went private works again when it is shared again.
  slug              String?         @unique @db.VarChar(16)
  /// When it was first published, kept when it is unpublished and republished.
  publishedAt       DateTime?
  /// Up to three of the tags that synth's library sounds use, chosen at publish.
  tags              String[]        @default([])
  /// When an admin unlisted it after a report (`f-sharing` h4): gone from every public read, and its owner cannot
  /// share or publish it again until an admin restores it. Its visibility is kept, so a restore brings it back as it was.
  unlistedAt        DateTime?
  /// The user pattern the sequencer opens on with this sound (`f-step-sequencer` t-81), always one of the owner's own.
  patternId         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  /// Restrict, unlike SynthSound's Cascade: deleting a synth must never take users' own sounds with it. Unlist it instead.
  synth           Synth        @relation(fields: [synthId], references: [id], onDelete: Restrict)
  sourceSound     SynthSound?  @relation(fields: [sourceSoundId], references: [id], onDelete: SetNull)
  sourceUserSound UserSound?   @relation("UserSoundCopies", fields: [sourceUserSoundId], references: [id], onDelete: SetNull)
  /// Copies other users saved from it.
  copies          UserSound[]  @relation("UserSoundCopies")
  /// The pattern it plays by default (`f-step-sequencer` t-81): one of its owner's, and none once that is deleted.
  pattern         UserPattern? @relation(fields: [patternId], references: [id], onDelete: SetNull)

  /// Its user's star on it.
  favourites Favourite[]
  /// What people reported about it (`f-sharing` h4).
  reports    SoundReport[]

  @@index([userId, updatedAt])
  @@index([synthId])
  @@index([sourceSoundId])
  @@index([sourceUserSoundId])
  @@index([userId, publishedAt])
  @@index([visibility, publishedAt])
  @@index([patternId])
  @@map("user_sound")
}

// ─── Users' patterns (f-step-sequencer t-81) ─────────────────────────────────
//
// A pattern a user saved from the sequencer: their own library, "My patterns", not tied to a synth (owner ruling on
// f-step-sequencer, 2026-10-21). A row is about a person, so it is declared for subject export in
// lib/app/data-export.ts. On SYSTEM_MODELS beside UserSound, with no orgId, by the same ruling as their sounds.
//
// `userId` is a plain string, as UserSound's is, so `User` needs no back-relation field. The FK is written by hand in
// the migration, `ON DELETE CASCADE`: erasing a user erases their patterns. A drift probe in lib/app/db-drift.ts pins it.

/// A user's own pattern (`lib/app/sequencer/pattern.ts`), validated with `PatternSchema` on write and on read
/// (lib/app/patterns/). Owner-scoped, until its owner shares it by link or publishes it (t-83,
/// lib/app/patterns/sharing.ts), as a sound is shared.
model UserPattern {
  id                  String          @id @default(cuid())
  /// FK to User.id, ON DELETE CASCADE (hand-written in the migration).
  userId              String
  name                String
  /// `Pattern`: the sequencer's pattern, its own `version` inside it.
  pattern             Json
  /// The pattern shape's version it was saved as (`PATTERN_VERSION`), beside the JSON so a mapping (D1) can find
  /// the rows it owes without reading them all.
  version             Int
  /// The synth it was made on. Informational only: a pattern plays on any synth. Not a foreign key, so a synth
  /// leaving the catalogue leaves it as it was.
  synthId             String?
  /// Who can open it (t-83): the sound's three levels, and the same rules (`.context/app/sequencer.md`).
  visibility          SoundVisibility @default(private)
  /// Its public address, `/patterns/<slug>`. Minted the first time it leaves private and kept after, as a sound's is.
  slug                String?         @unique @db.VarChar(16)
  /// When it was first published, kept when it is unpublished and republished.
  publishedAt         DateTime?
  /// When an admin unlisted it after a report: gone from every public read, and its owner cannot share or publish it
  /// again until an admin restores it. Its visibility is kept, so a restore brings it back as it was.
  unlistedAt          DateTime?
  /// The shared pattern it was copied from. Null for anything else, and once that pattern is deleted or its owner
  /// erased. The credit is read through it while that pattern is published, never kept, so it cannot outlive the
  /// erasure of the person it names.
  sourceUserPatternId String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  /// The user's sounds that play it by default.
  sounds            UserSound[]
  sourceUserPattern UserPattern?    @relation("UserPatternCopies", fields: [sourceUserPatternId], references: [id], onDelete: SetNull)
  /// Copies other users saved from it.
  copies            UserPattern[]   @relation("UserPatternCopies")
  /// What people reported about it.
  reports           PatternReport[]

  @@index([userId, updatedAt])
  @@index([sourceUserPatternId])
  @@index([userId, publishedAt])
  @@index([visibility, publishedAt])
  @@map("user_pattern")
}

/// A report about someone's shared pattern (t-83): `SoundReport`'s shape, its reasons and statuses, for patterns. It
/// outlives the person who filed it and the admin who resolved it (hand-written FKs, SET NULL) and goes with the pattern
/// (Cascade). On SYSTEM_MODELS beside UserPattern, with no orgId. Declared for subject export as the reports a person
/// filed, never who resolved them.
model PatternReport {
  id           String            @id @default(cuid())
  patternId    String
  /// FK to User.id, ON DELETE SET NULL (hand-written in the migration). Never shown to anyone but the reporter.
  reporterId   String?
  reason       SoundReportReason
  note         String?           @db.Text
  status       SoundReportStatus @default(open)
  /// FK to User.id, ON DELETE SET NULL (hand-written in the migration). The admin who dismissed or actioned it.
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  pattern UserPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([patternId, status])
  @@index([reporterId])
  @@index([resolvedById])
  @@map("pattern_report")
}

// ─── Reports about shared sounds (f-sharing h4) ──────────────────────────────
//
// A signed-in user reports someone's shared sound; an admin unlists it, restores it or dismisses the reports. The
// report is the moderation record about a sound, so it outlives the person who filed it and the admin who resolved it
// (both hand-written FKs, SET NULL), and goes with the sound (Cascade). On SYSTEM_MODELS beside UserSound, with no
// orgId: the queue is every user's sounds, decided from one place. Declared for subject export in lib/app/data-export.ts
// as the reports a person filed, never who resolved them.

enum SoundReportReason {
  /// Offensive or hateful words in its name or notes (a pattern's name).
  offensive
  /// Someone else's sound (or pattern) put up as theirs.
  not_theirs
  spam
  other
}

enum SoundReportStatus {
  open
  /// An admin looked and left the sound up.
  dismissed
  /// An admin unlisted the sound.
  actioned
}

model SoundReport {
  id           String            @id @default(cuid())
  soundId      String
  /// FK to User.id, ON DELETE SET NULL (hand-written in the migration). Never shown to anyone but the reporter.
  reporterId   String?
  reason       SoundReportReason
  note         String?           @db.Text
  status       SoundReportStatus @default(open)
  /// FK to User.id, ON DELETE SET NULL (hand-written in the migration). The admin who dismissed or actioned it.
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  sound UserSound @relation(fields: [soundId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([soundId, status])
  @@index([reporterId])
  @@index([resolvedById])
  @@map("sound_report")
}

// ─── Users' preferences and last panels (f-my-sounds s3) ─────────────────────
//
// What the synth page keeps in browser storage for a visitor (components/app/synth/storage.ts), kept under the
// account for a signed-in user so it follows them to another device. Screen-only keys (`kys.synth`, `view`,
// `fxOpen`, `midi`) stay in the browser (D4). Both are about a person, so they are declared for subject export in
// lib/app/data-export.ts, and both sit on SYSTEM_MODELS with no orgId, as UserSound does.
//
// `userId` is a plain string, so `User` needs no back-relation field. Each FK is written by hand in the migration,
// `ON DELETE CASCADE`, and pinned by a drift probe in lib/app/db-drift.ts.

/// A signed-in user's last panel on one synth: the `kys.session.<id>` shape. The panel is checked against the synth's
/// definition on write (`validateSound`) and fitted to it on read (lib/app/sounds/preferences.ts).
model SynthPreference {
  /// FK to User.id, ON DELETE CASCADE (hand-written in the migration).
  userId            String
  synthId           String
  /// The definition version the panel was saved on.
  definitionVersion Int
  /// The library sound the panel came from (its slug), which the lesson reads.
  presetId          String?
  /// The lesson step, or null for the finished sound.
  step              Int?
  /// The user's own sound open on the panel. Only an id: whether it is still theirs is the sounds API's answer.
  soundId           String?
  /// `ControlValues`: control id → value.
  values            Json
  /// `CablePair[]`: `[outputJackId, inputJackId]`.
  cables            Json
  updatedAt         DateTime @updatedAt

  synth Synth @relation(fields: [synthId], references: [id], onDelete: Cascade)

  @@id([userId, synthId])
  @@index([synthId])
  @@map("synth_preference")
}

/// A signed-in user's settings on the synth page. A null column is one the account has no value for yet: the page
/// fills it once from the browser's, and otherwise the account's value wins.
model UserPreference {
  /// FK to User.id, ON DELETE CASCADE (hand-written in the migration).
  userId    String   @id
  /// `kys.tips`: info cards on hover.
  tips      Boolean?
  /// `kys.dim`: the sound map's "Dim unused parts".
  dim       Boolean?
  /// `kys.heat`: the sound map's "Show sensitive controls".
  heat      Boolean?
  /// `kys.harm`: the harmonics strip under the panel.
  harm      Boolean?
  /// `kys.fx`: the effects rack's settings (`RackFx`).
  fx        Json?
  updatedAt DateTime @updatedAt

  @@map("user_preference")
}

// ─── Lesson progress and favourites (f-my-sounds s4) ─────────────────────────
//
// How far a signed-in user has got through each library sound's lesson, and what they have starred: a synth, a library
// sound or one of their own sounds. Both are about a person, so they are declared for subject export in
// lib/app/data-export.ts, and both sit on SYSTEM_MODELS with no orgId, as UserSound does.
//
// `userId` is a plain string, so `User` needs no back-relation field. Each FK is written by hand in the migration,
// `ON DELETE CASCADE`, and pinned by a drift probe in lib/app/db-drift.ts. What a row points at is a real relation,
// `Cascade`: a progress or a star on something that has gone means nothing.

/// How far a user has got through one library sound's lesson (lib/app/sounds/progress.ts). Only ever moves forward.
model LessonProgress {
  /// FK to User.id, ON DELETE CASCADE (hand-written in the migration).
  userId       String
  soundId      String
  /// The furthest lesson step reached, from 0.
  furthestStep Int
  /// When the user first finished the lesson; null until then.
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sound SynthSound @relation(fields: [soundId], references: [id], onDelete: Cascade)

  @@id([userId, soundId])
  @@index([soundId])
  @@map("lesson_progress")
}

/// A user's star on exactly one of a synth, a library sound or one of their own sounds (lib/app/sounds/favourites.ts,
/// which keeps it to one). Postgres treats nulls as distinct, so each unique binds only the column that is set.
model Favourite {
  id           String   @id @default(cuid())
  /// FK to User.id, ON DELETE CASCADE (hand-written in the migration).
  userId       String
  synthId      String?
  synthSoundId String?
  userSoundId  String?
  createdAt    DateTime @default(now())

  synth      Synth?      @relation(fields: [synthId], references: [id], onDelete: Cascade)
  synthSound SynthSound? @relation(fields: [synthSoundId], references: [id], onDelete: Cascade)
  userSound  UserSound?  @relation(fields: [userSoundId], references: [id], onDelete: Cascade)

  @@unique([userId, synthId])
  @@unique([userId, synthSoundId])
  @@unique([userId, userSoundId])
  @@index([synthId])
  @@index([synthSoundId])
  @@index([userSoundId])
  @@map("favourite")
}

// ─── Synth profiles (f-profiles r1) ──────────────────────────────────────────
//
// The public face of a user: the username they choose (never the account name or email), a link each for YouTube,
// Spotify, Instagram and Bandcamp, and who may see it. The rules for a username and a link are
// lib/app/profile/username.ts and links.ts, the one place each is written; lib/app/profile/profile.ts is where they meet
// the database. On SYSTEM_MODELS with no orgId, as UserSound is: a profile is its user's in every org.
//
// `userId` is a plain string, so `User` needs no back-relation field. The FK is written by hand in the migration,
// `ON DELETE CASCADE`, and pinned by a drift probe in lib/app/db-drift.ts. The profile is about a person, so it is
// declared for subject export in lib/app/data-export.ts.

/// A user's synth profile. Born private, with owned and wishlist hidden: nothing about a person goes public until they
/// switch it on.
model SynthProfile {
  /// FK to User.id, ON DELETE CASCADE (hand-written in the migration). One profile per user.
  userId                 String     @id
  /// Stored lower-case, so uniqueness is case-insensitive.
  username               String     @unique @db.VarChar(24)
  /// When the username last changed; null until the first change. Choosing the first one is not a change.
  usernameChangedAt      DateTime?
  /// Each link as lib/app/profile/links.ts rebuilds it, never the string typed. Null for none.
  youtube                String?
  spotify                String?
  instagram              String?
  bandcamp               String?
  /// Whether /u/<username> shows anything. Off: the page is a 404.
  public                 Boolean    @default(false)
  /// Whether the public page lists the synths they own, and the ones they want (f-profiles r2).
  showOwned              Boolean    @default(false)
  showWishlist           Boolean    @default(false)
  /// When they first published each sound in the last 24 hours, pruned at each publish: what the daily cap counts
  /// (lib/app/sounds/publish.ts). Kept here, not counted from user_sound, so deleting a published sound does not give
  /// its place back.
  recentPublishes        DateTime[] @default([])
  /// The same for patterns (t-83, lib/app/patterns/sharing.ts): a cap of their own, so publishing patterns does not
  /// use up the day's sounds.
  recentPatternPublishes DateTime[] @default([])
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@map("synth_profile")
}

/// A username someone has just given up, held so nobody else can take it while links to the old /u/ address still
/// circulate. No user FK: it records a name, not a person, and outlives the change that released it.
model HeldUsername {
  username  String   @id @db.VarChar(24)
  heldUntil DateTime

  @@map("held_username")
}

// ─── Synths owned and wanted (f-profiles r2) ─────────────────────────────────
//
// The synths a user has and the ones they're after, picked from the databank's instruments. The rules are
// lib/app/profile/instruments.ts. On SYSTEM_MODELS with no orgId, as SynthProfile is.
//
// `userId` is a plain string, so `User` needs no back-relation field. The FK is written by hand in the migration,
// `ON DELETE CASCADE`, and pinned by a drift probe in lib/app/db-drift.ts; the entries are exported in
// lib/app/data-export.ts. The instrument is a real relation, `Cascade`, as a favourite's is: an entry on an instrument
// the databank removed means nothing, and `Restrict` would let one user's list stop an admin removing a duplicate.

/// Which of a user's two lists an instrument is on.
enum OwnedInstrumentKind {
  owned
  wishlist
}

/// One instrument on one of a user's lists. Keyed on the user and the instrument, so a synth is on one list or the
/// other, never both: moving it is an update.
model OwnedInstrument {
  /// FK to User.id, ON DELETE CASCADE (hand-written in the migration).
  userId       String
  instrumentId String
  kind         OwnedInstrumentKind
  /// Its place in its list, from 0. Writes to one user's lists take a lock on their user row, so places do not tie.
  position     Int
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  instrument BankInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@id([userId, instrumentId])
  @@index([userId, kind, position])
  @@index([instrumentId])
  @@map("owned_instrument")
}
