{
  "schema_version": "0.10.0",
  "device": {
    "id": "roland-jupiter-4",
    "manufacturer": "Roland",
    "model": "Jupiter-4 Compuphonic (JP-4)",
    "category": "4-voice polyphonic analogue synthesizer with microprocessor-controlled memory and arpeggiator",
    "based_on": "Original design, 1978-81. Roland's first self-contained polyphonic synthesizer.",
    "sources": [
      {
        "id": "manual",
        "title": "Roland Jupiter-4 Owner's Manual (JP-4 OWNER'S MANUAL '82 AUG.)",
        "kind": "user_manual",
        "file": "Roland_Jupiter_4_Manual.pdf",
        "pages": 42,
        "note": "Internet Archive scan with an imperfect OCR layer. Front panel, programmable, modifier and controller sections, assign modes, arpeggio, memory, connections and specifications. Sample sound charts are drawings and not read."
      },
      {
        "id": "plugout",
        "title": "Roland JUPITER-4 PLUG-OUT Software Synthesizer Owner's Manual (2022)",
        "kind": "other",
        "file": "Jupiter-4_Manual.pdf",
        "pages": 15,
        "note": "A software recreation with extra features. Used to confirm assign mode and portamento behaviour; its additions are listed in modelling_gaps."
      },
      {
        "id": "wikipedia",
        "title": "Wikipedia, 'Roland Jupiter-4'",
        "kind": "other",
        "file": "https://en.wikipedia.org/wiki/Roland_Jupiter-4",
        "note": "Two ADSRs per voice, LFO reaching audio rate, voice card revisions (BA662 and IR3109 filters), MN3004-based ensemble, unmemorised master volume and portamento."
      }
    ]
  },
  "architecture": {
    "synthesis": "subtractive",
    "signal_path": "analogue",
    "voices": 4,
    "polyphony_mode": "polyphonic, 4 voices; unison modes",
    "poly_chain_max_units": null,
    "patch_memory": true,
    "patch_memory_note": "8 user memories (COMPU-MEMORY) plus 10 fixed presets, battery backed. The modifier and controller sections are not memorised.",
    "semi_modular": false,
    "panel_counts": {
      "keys": 49,
      "user_memories": 8,
      "presets": 10
    },
    "summary": "Four voice cards, each with one VCO plus a sub-oscillator, noise, a high-pass filter, a resonant low-pass VCF with its own ADSR, and a VCA with a second ADSR. One LFO, an arpeggiator and four voice assign modes run on two microcontrollers, which also store 8 patches beside 10 presets. A modifier section adds a trigger generator for the arpeggio and a noise sample-and-hold on the filter, LFO delay and a live LFO rate offset. A stereo ensemble chorus feeds two outputs."
  },
  "modules": [
    {
      "id": "kbd",
      "type": "voice_allocator",
      "name": "Keyboard, assigner and arpeggio",
      "panel_section": "ARPEGGIO / KEY ASSIGNMENT / CONTROLLER",
      "scope": "common",
      "description": "49-key keyboard with four assign modes, an up/down/up+down/random arpeggio over up to four octaves, hold, polyphonic portamento, transpose and master tuning. Sends pitch CV and gates to the four voices.",
      "properties": {
        "keys": 49,
        "range_octaves_with_transpose": 7
      },
      "inputs": ["kbd.clock_in", "kbd.hold_in"],
      "outputs": ["kbd.cv", "kbd.gate"]
    },
    {
      "id": "trig",
      "type": "gate_logic",
      "name": "Trigger generator",
      "panel_section": "MODIFIER: TRIGGER",
      "scope": "common",
      "description": "Internal clock for the arpeggio and the filter sample-and-hold, with an external clock input as the alternative source for either.",
      "properties": {
        "rate_hz": [null, 25]
      },
      "inputs": ["trig.ext_in"],
      "outputs": ["trig.int", "trig.ext"]
    },
    {
      "id": "lfo",
      "type": "lfo",
      "name": "LFO",
      "panel_section": "PROGRAMMABLE: LFO",
      "scope": "common",
      "description": "One LFO shared by all voices, 0.1 to 80 Hz, so it reaches audio rate for crude FM and AM. Its rate is memorised; the modifier section's LFO BEND slider offsets it live, and DELAY TIME fades it in on each new key.",
      "properties": {
        "rate_hz": [0.1, 80],
        "waveforms": ["sine (triangle)", "square", "sawtooth", "reverse sawtooth"]
      },
      "inputs": [],
      "outputs": ["lfo.out"]
    },
    {
      "id": "noise",
      "type": "noise",
      "name": "Noise generator",
      "panel_section": "PROGRAMMABLE: NOISE",
      "scope": "common",
      "description": "Noise source for the voices and for the filter sample-and-hold.",
      "inputs": [],
      "outputs": ["noise.out"]
    },
    {
      "id": "snh",
      "type": "sample_hold",
      "name": "VCF sample and hold",
      "panel_section": "MODIFIER: VCF",
      "scope": "common",
      "description": "Samples noise at the trigger rate (or an external clock) to step the filter cutoff randomly.",
      "inputs": ["snh.in", "snh.clock"],
      "outputs": ["snh.out"]
    },
    {
      "id": "vco",
      "type": "oscillator",
      "name": "VCO",
      "panel_section": "PROGRAMMABLE: VCO",
      "scope": "per_voice",
      "description": "One VCO per voice: off, sawtooth, square or pulse, at 16', 8' or 4'. Pulse width is set to one of four widths or modulated by the LFO. A sub-oscillator adds a square one octave down.",
      "properties": {
        "ranges": ["16'", "8'", "4'"],
        "pulse_widths_pct": [50, 40, 20, 10]
      },
      "inputs": ["vco.pitch_cv", "vco.pw_cv"],
      "outputs": ["vco.wave", "vco.sub"]
    },
    {
      "id": "mix",
      "type": "mixer",
      "name": "Voice source mix",
      "panel_section": "PROGRAMMABLE",
      "scope": "per_voice",
      "description": "Combines the VCO waveform, sub-oscillator and noise as switched on.",
      "inputs": ["mix.wave", "mix.sub", "mix.noise"],
      "outputs": ["mix.out"]
    },
    {
      "id": "hpf",
      "type": "filter",
      "name": "HPF",
      "panel_section": "PROGRAMMABLE: VCF",
      "scope": "per_voice",
      "description": "High-pass filter ahead of the low-pass VCF; at minimum it passes everything.",
      "properties": {
        "cutoff_hz": [40, 5000]
      },
      "inputs": ["hpf.in"],
      "outputs": ["hpf.out"]
    },
    {
      "id": "vcf",
      "type": "filter",
      "name": "VCF (low-pass)",
      "panel_section": "PROGRAMMABLE: VCF",
      "scope": "per_voice",
      "description": "Resonant low-pass filter, self-oscillating at full resonance, with keyboard follow, LFO and envelope modulation.",
      "properties": {
        "self_oscillates": true,
        "chip": "BA662 on early B/C/D voice cards, IR3109 on later E cards (Wikipedia)"
      },
      "inputs": ["vcf.in", "vcf.cutoff_cv"],
      "outputs": ["vcf.out"]
    },
    {
      "id": "env_f",
      "type": "envelope",
      "name": "VCF envelope (ADSR)",
      "panel_section": "PROGRAMMABLE: ENVELOPE",
      "scope": "per_voice",
      "description": "ADSR for the filter, with a polarity switch.",
      "inputs": ["env_f.gate"],
      "outputs": ["env_f.out"]
    },
    {
      "id": "env_a",
      "type": "envelope",
      "name": "VCA envelope (ADSR)",
      "panel_section": "PROGRAMMABLE: ENVELOPE",
      "scope": "per_voice",
      "description": "ADSR for the VCA.",
      "inputs": ["env_a.gate"],
      "outputs": ["env_a.out"]
    },
    {
      "id": "vca",
      "type": "vca",
      "name": "VCA",
      "panel_section": "PROGRAMMABLE: VCA",
      "scope": "per_voice",
      "description": "Shapes each voice with its envelope; LEVEL sets the memorised output, with an overload lamp.",
      "inputs": ["vca.in", "vca.cv"],
      "outputs": ["vca.out"]
    },
    {
      "id": "bend",
      "type": "manual_controller",
      "name": "Bend / modulation lever",
      "panel_section": "CONTROLLER: BEND / MODULATION",
      "scope": "common",
      "description": "Spring-loaded left-right lever. For each of VCO, VCF and VCA a switch picks BEND, OFF or LFO: BEND moves that destination by BEND SENS, LFO makes the lever set the depth of LFO modulation up to LFO MOD.",
      "inputs": [],
      "outputs": ["bend.cv"]
    },
    {
      "id": "ens",
      "type": "chorus",
      "name": "Ensemble",
      "panel_section": "ENSEMBLE",
      "scope": "common",
      "description": "Stereo chorus on the summed voices (two MN3004 bucket brigades, per Wikipedia).",
      "inputs": ["ens.in"],
      "outputs": ["ens.out_a", "ens.out_b"]
    },
    {
      "id": "out",
      "type": "output",
      "name": "Output",
      "panel_section": "VOLUME / connection jacks",
      "scope": "common",
      "description": "Master VOLUME (not memorised), expression pedal, mono and stereo outputs, headphones.",
      "inputs": ["out.in_a", "out.in_b", "out.exp_cv"],
      "outputs": ["out.mono", "out.stereo", "out.phones"]
    },
    {
      "id": "memory",
