  "behaviours": [
    {
      "id": "b01",
      "name": "Assign modes",
      "applies_to": ["kbd"],
      "rule": "UNISON 1: all four voices play the lowest held key. UNISON 2: one key gets four voices, two keys two each, three or four keys one each. POLY 1: voices rotate in the order keys are played; suits arpeggios. POLY 2: a key reuses the same voice, so after a chord a single note keeps only its own release; suits portamento."
    },
    {
      "id": "b02",
      "name": "Arpeggio",
      "applies_to": ["kbd", "trig"],
      "rule": "Arpeggiates held keys up to four octaves above the first note, in UP, DOWN, UP + DOWN or RANDOM. The order follows the order keys were played, except RANDOM. Speed is the trigger RATE, or an external clock."
    },
    {
      "id": "b03",
      "name": "Memory and presets",
      "applies_to": ["memory"],
      "rule": "MANUAL plays the programmable panel. COMPU-MEMORY 1-8 recall user patches; 10 presets are fixed. Writing needs MEMORY WRITE pressed together with PROTECTION. The modifier and controller sections, master volume and portamento always act live and are not stored. A rechargeable battery keeps memory; power the unit every six months."
    },
    {
      "id": "b04",
      "name": "Modifier section",
      "applies_to": ["trig", "snh", "lfo"],
      "rule": "Always live, even over memories. The trigger generator clocks the arpeggio and a noise sample-and-hold on the filter. LFO BEND offsets the memorised LFO rate (WIDE extends its range). DELAY TIME fades LFO modulation in after each new key, but only the first note of a legato phrase. Reset these to their normal positions when not in use."
    },
    {
      "id": "b05",
      "name": "Lever",
      "applies_to": ["bend"],
      "rule": "Each of VCO, VCF and VCA is set to BEND, OFF or LFO. BEND destinations move with the lever by up to BEND SENS; LFO destinations get LFO modulation whose depth follows the lever up to LFO MOD."
    },
    {
      "id": "b06",
      "name": "Keyboard range",
      "applies_to": ["kbd", "vco"],
      "rule": "49 keys; VCO RANGE (16', 8', 4') and TRANSPOSE extend the playable range to seven octaves. At 8' with TRANSPOSE off, the second C from the left is middle C."
    },
    {
      "id": "b07",
      "name": "Envelopes",
      "applies_to": ["env_f", "env_a"],
      "rule": "Separate ADSRs for filter and amplifier. With all four sliders at 0 the envelope is a click. With S high, D has little effect. The filter envelope can be inverted for special effects."
    }
  ],
  "midi": {
    "receives": [],
    "transmits": [],
    "note": "None. External control is an arpeggio/sample-and-hold clock input and pedals."
  },
