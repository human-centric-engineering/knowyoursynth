      "name": "COMPU-MEMORY and presets",
      "panel_section": "MEMORY",
      "scope": "common",
      "description": "Selects the programmable panel (MANUAL), one of 8 user memories or one of 10 presets.",
      "inputs": [],
      "outputs": []
    }
