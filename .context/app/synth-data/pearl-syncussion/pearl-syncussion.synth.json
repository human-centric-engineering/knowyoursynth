{
  "schema_version": "0.10.0",
  "device": {
    "id": "pearl-syncussion-sy-1",
    "manufacturer": "Pearl",
    "model": "Syncussion SY-1 (Syncussion-1) control board",
    "category": "two-channel analogue percussion synthesizer, played from CU-1 drum pads",
    "based_on": "Original design, 1979; recreated by the Behringer Syncussion SY-1 (modelled separately).",
    "sources": [
      {
        "id": "pearl",
        "title": "Pearl Syncussion-1 brochure and operating guide (1979)",
        "kind": "user_manual",
        "file": "Syncussion_2_1979.pdf",
        "pages": 4,
        "note": "Original control descriptions (TUNE sets both oscillators and the filter; WIDTH sets the filter sweep range; LFO and S&H move pitch), mode character, specifications."
      },
      {
        "id": "bergfotron",
        "title": "Bergfotron, 'Super Syncussion' (from the original schematics)",
        "kind": "other",
        "file": "http://bergfotron.synth.net/Percussion/super%20syncussion.html",
        "note": "Per-voice structure (two VCOs, LPF, decay EG on the VCA, sweep EG, noise, LFO, S&H), fixed oscillator interval, mode routing for B, C and D."
      },
      {
        "id": "alyjames",
        "title": "AlyJamesLab, SY-4X technical overview of the original",
        "kind": "other",
        "file": "https://www.alyjameslab.com/alyjameslabsy4x.html",
        "note": "Two envelopes per voice; envelope 2 drives VCA, filter and (by mode) tuning; trigger strength sets envelope level."
      },
      {
        "id": "sy05",
        "title": "Mod Wiggler, 'Sy0.5 10HP Syncussion clone'",
        "kind": "other",
        "file": "https://www.modwiggler.com/forum/viewtopic.php?t=207564",
        "note": "Original oscillators calibrated at 440 and 450 Hz."
      }
    ]
  },
  "architecture": {
    "synthesis": "subtractive",
    "signal_path": "analogue",
    "voices": 2,
    "polyphony_mode": "two independent monophonic channels",
    "poly_chain_max_units": null,
    "patch_memory": false,
    "semi_modular": false,
    "panel_counts": {
      "channels": 2,
      "faders_per_channel": 8
    },
    "summary": "Two identical channels. Each has two oscillators set by a six-position mode switch (single, FM, mix, velocity-swept mix, FM plus noise, noise only), a pitch sweep up or down with speed and range, an LFO (square or triangle) with sample and hold, a low-pass filter swept by the decay envelope over the WIDTH range, a decay and an output level. Played from CU-1 drum pads or microphones, with dynamics from how hard each pad is hit; both channels share one output. No MIDI."
  },
  "modules": [
    {
      "id": "outmix",
      "type": "summer",
      "name": "Output mix",
      "panel_section": "(rear panel)",
      "description": "Sums both channels to the single OUTPUT.",
      "inputs": ["outmix.in1", "outmix.in2"],
      "outputs": ["outmix.out"]
    },
    {
      "id": "mute",
      "type": "gate_logic",
      "name": "Mute",
      "panel_section": "(rear panel)",
      "description": "Footswitch input that cuts off the decay on both channels.",
      "inputs": ["mute.in"],
      "outputs": ["mute.out"]
    },
    {
      "id": "ch1_trig",
      "type": "envelope_follower",
      "name": "Channel 1 trigger",
      "panel_section": "CHANNEL 1",
      "description": "Trigger from the INPUT (CU-1 pad or microphone) past the SENSITIVITY threshold; also measures how hard the pad was hit.",
      "inputs": ["ch1_trig.ext"],
      "outputs": ["ch1_trig.gate", "ch1_trig.strength"]
    },
    {
      "id": "ch1_noise",
      "type": "noise",
      "name": "Channel 1 noise",
      "panel_section": "CHANNEL 1",
      "description": "White noise for modes E and F (the original's is fairly soft).",
      "inputs": [],
      "outputs": ["ch1_noise.out"]
    },
    {
      "id": "ch1_tune",
      "type": "pitch_control",
      "name": "Channel 1 tune",
      "panel_section": "CHANNEL 1",
      "description": "TUNE fader and fine knob plus the TUNE jack and MIDI pitch: sets both oscillators and the filter cutoff together.",
      "inputs": ["ch1_tune.ext"],
      "outputs": ["ch1_tune.cv"]
    },
    {
      "id": "ch1_osc1",
      "type": "oscillator",
      "name": "Channel 1 oscillator 1",
      "panel_section": "CHANNEL 1",
      "description": "Oscillator 1: heard alone in mode A, mixed in C and D, and the FM modulator in B and E.",
      "properties": {
        "calibration_hz": 440
      },
      "inputs": ["ch1_osc1.pitch_cv"],
      "outputs": ["ch1_osc1.out"]
    },
    {
      "id": "ch1_osc2",
      "type": "oscillator",
      "name": "Channel 1 oscillator 2",
      "panel_section": "CHANNEL 1",
      "description": "Oscillator 2: the frequency-modulated output in B and E, mixed in C and D. Its interval to oscillator 1 is fixed by an internal trimmer.",
      "properties": {
        "calibration_hz": 450,
        "interval": "fixed by trimmer; not user adjustable on the original"
      },
      "inputs": ["ch1_osc2.pitch_cv", "ch1_osc2.fm"],
      "outputs": ["ch1_osc2.out"]
    },
    {
      "id": "ch1_mix",
      "type": "mixer",
      "name": "Channel 1 source mix",
      "panel_section": "CHANNEL 1",
      "description": "Combines oscillators and noise according to OSC MODE.",
      "inputs": ["ch1_mix.osc1", "ch1_mix.osc2", "ch1_mix.noise"],
      "outputs": ["ch1_mix.out"]
    },
    {
      "id": "ch1_sweep",
      "type": "envelope",
      "name": "Channel 1 sweep",
      "panel_section": "CHANNEL 1",
      "description": "Pitch sweep on each trigger, up or down, at SWEEP SPEED over SWEEP RANGE; in mode D its depth follows trigger strength.",
      "inputs": ["ch1_sweep.gate", "ch1_sweep.depth_cv"],
      "outputs": ["ch1_sweep.out"]
    },
    {
      "id": "ch1_lfo",
      "type": "lfo",
      "name": "Channel 1 LFO",
      "panel_section": "CHANNEL 1",
      "description": "Square or triangle LFO, 0.4-50 Hz, or off; also clocks the sample and hold.",
      "properties": {
        "rate_hz": [0.4, 50]
      },
      "inputs": [],
      "outputs": ["ch1_lfo.out", "ch1_lfo.clock"]
    },
    {
      "id": "ch1_snh",
      "type": "sample_hold",
      "name": "Channel 1 sample and hold",
      "panel_section": "CHANNEL 1",
      "description": "Random steps on pitch at the LFO rate, even with the LFO wave switched off.",
      "inputs": ["ch1_snh.in", "ch1_snh.clock"],
      "outputs": ["ch1_snh.out"]
    },
    {
      "id": "ch1_vcf",
      "type": "filter",
      "name": "Channel 1 filter",
      "panel_section": "CHANNEL 1",
      "description": "Low-pass filter. Cutoff follows TUNE; the decay envelope sweeps it down from high, over a range set by WIDTH.",
      "inputs": ["ch1_vcf.in", "ch1_vcf.cutoff_cv"],
      "outputs": ["ch1_vcf.out"]
    },
    {
      "id": "ch1_env",
      "type": "envelope",
      "name": "Channel 1 decay",
      "panel_section": "CHANNEL 1",
      "description": "Decay-only envelope (envelope 2 on the original), 6 ms to 2.5 s depending on tuning; its level follows trigger strength. Drives the VCA, the filter and, in mode D, oscillator 2's pitch.",
      "properties": {
        "decay_s": [0.006, 2.5]
      },
      "inputs": ["ch1_env.gate", "ch1_env.mute", "ch1_env.level_cv"],
      "outputs": ["ch1_env.out"]
    },
    {
      "id": "ch1_vca",
      "type": "vca",
      "name": "Channel 1 VCA",
      "panel_section": "CHANNEL 1",
      "description": "Shapes the channel with its decay; OUTPUT sets the level.",
      "inputs": ["ch1_vca.in", "ch1_vca.cv"],
      "outputs": ["ch1_vca.out"]
    },
