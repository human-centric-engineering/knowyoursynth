  "behaviours": [
    {
      "id": "b01",
      "name": "Oscillator modes",
      "applies_to": ["ch1_osc1", "ch2_osc1"],
      "rule": "A: oscillator 1 alone, the classic drum-synth sweep. B: oscillator 1 frequency-modulates oscillator 2, which is heard; metallic. C: both mixed, oscillator 1 lower; vibraphone-like. D: both mixed; soft or hard hits sweep low to high, independent of SWEEP SPEED and RANGE (the sweep moves oscillator 1, the decay envelope oscillator 2). E: FM as B plus noise; struck thin metal. F: noise only. Both channels at once (A plus F) give an 808-style snare."
    },
    {
      "id": "b02",
      "name": "Pitch sweep",
      "applies_to": ["ch1_sweep", "ch2_sweep"],
      "rule": "Each trigger sweeps the pitch up or down at SWEEP SPEED over SWEEP RANGE: the classic synth-tom and laser sounds. OFF holds the tuned pitch."
    },
    {
      "id": "b03",
      "name": "LFO and sample and hold",
      "applies_to": ["ch1_lfo", "ch2_lfo", "ch1_snh", "ch2_snh"],
      "rule": "The LFO (square or triangle) modulates at LFO DEPTH. S&H adds random steps at the LFO SPEED rate, and keeps working with the LFO wave switched off."
    },
    {
      "id": "b04",
      "name": "Decay, filter and dynamics",
      "applies_to": ["ch1_env", "ch2_env", "ch1_vcf", "ch2_vcf"],
      "rule": "One decay envelope shapes the VCA and sweeps the filter down from high over the WIDTH range; TUNE moves the oscillators and filter cutoff together. Trigger strength sets the envelope level, so hard hits are louder and brighter. Decay runs from 6 ms to 2.5 s depending on tuning; MUTE cuts it off."
    },
    {
      "id": "b07",
      "name": "Fixed oscillator interval",
      "applies_to": ["ch1_osc2", "ch2_osc2"],
      "rule": "The interval between the two oscillators is set by an internal trimmer (originally 440 and 450 Hz), not by a panel control."
    },
    {
      "id": "b06",
      "name": "Trigger sensitivity",
      "applies_to": ["ch1_trig", "ch2_trig"],
      "rule": "Each channel's rear SENSITIVITY knob is set so its trigger light comes on when the pad is struck, matching the player's style."
    },
    {
      "id": "b08",
      "name": "Playing from pads",
      "applies_to": ["ch1_trig", "ch2_trig"],
      "rule": "Each channel is played from a CU-1 drum pad (same pickup as Pearl's drum units, head tension adjustable with a drum key) or a microphone. Volume and brilliance follow how hard the pad is hit."
    },
    {
      "id": "b09",
      "name": "Pedals",
