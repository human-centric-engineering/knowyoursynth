{
  "schema_version": "0.12.0",
  "device": {
    "id": "sequential-circuits-prophet-5-rev3",
    "manufacturer": "Sequential Circuits",
    "model": "Prophet-5 (Model 1000), Revision 3.3",
    "category": "5-voice programmable polyphonic analogue synthesizer, 61 keys",
    "based_on": "Original design, January 1978 (Dave Smith and John Bowen); Rev 3.3 (serial 4064 up) has 120 programs in three files.",
    "sources": [
      {
        "id": "manual",
        "title": "Prophet-5 Synthesizer Operation Manual, Revision 3.3 (CM1000D, February 1982), by Stanley Jungleib",
        "kind": "user_manual",
        "file": "Prophet-5_Owner_s_Manual.pdf",
        "pages": 94,
        "note": "Internet Archive scan with an imperfect OCR layer. Basic operation, front and back panel, cassette, Scale Mode, system interface (with the 24-byte program format), factory programs. Panel figures are images."
      }
    ]
  },
  "architecture": {
    "synthesis": "subtractive",
    "signal_path": "analogue",
    "voices": 5,
    "polyphony_mode": "5-voice polyphonic, last-note priority (same key reuses its voice); UNISON stacks all five on the lowest key",
    "poly_chain_max_units": null,
    "patch_memory": true,
    "patch_memory_note": "120 programs as three files of 40 (five banks of eight); one file active at a time, in non-volatile RAM. Each location holds a patch or a Scale program. Files and banks save to cassette.",
    "semi_modular": false,
    "panel_counts": {
      "keys": 61,
      "programmable_knobs": 24,
      "programmable_switches": 22
    },
    "summary": "Each of five voices has OSC A (saw and/or pulse, sync to B), OSC B (saw, triangle and/or pulse, fine tune, low-frequency and keyboard switches), white noise, a mixer, a resonant 24 dB/oct low-pass filter with its own ADSR and keyboard tracking, and a VCA with ADSR. One panel patches all five. Poly-Mod sends the filter envelope and OSC B, per voice, to OSC A frequency, OSC A pulse width and the filter. Wheel-Mod sends a mix of the LFO (saw, triangle, square) and pink noise, scaled by the mod wheel, to either oscillator's frequency or pulse width and the filter. Microcomputer tuning, 120 programs, Scale Mode for alternative tunings."
  },
  "modules": [
    {
      "id": "kbd",
      "type": "voice_allocator",
      "name": "Keyboard and voice assigner",
      "panel_section": "KEYBOARD / MISCELLANEOUS",
      "scope": "common",
      "description": "61 keys (C0-C5) under microcomputer scanning; assigns five voices, or all five to the lowest key in UNISON (with GLIDE). Voice 5 can be handed to the sequencer interface.",
      "properties": {
        "keys": 61,
        "range": "C0-C5"
      },
      "inputs": ["kbd.ext_cv", "kbd.ext_gate", "kbd.release_fs", "kbd.digital_in"],
      "outputs": ["kbd.cv", "kbd.gate", "kbd.cv_out", "kbd.gate_out"]
    },
    {
      "id": "wheels",
      "type": "manual_controller",
      "name": "Pitch and mod wheels",
      "panel_section": "LEFT OF KEYBOARD",
      "scope": "common",
      "description": "Pitch wheel (centre detent, about a fifth either way) and mod wheel (sets Wheel-Mod depth). Remote CVs via the ANALOG jack.",
      "inputs": ["wheels.pitch_cv_in", "wheels.mod_cv_in"],
      "outputs": ["wheels.pitch", "wheels.mod"]
    },
    {
      "id": "osc_a",
      "type": "oscillator",
      "name": "Oscillator A",
      "panel_section": "OSCILLATOR A",
      "scope": "per_voice",
      "description": "Audio VCO always on the keyboard: frequency stepped in semitones over four octaves, sawtooth and/or pulse (width about 1-99%), hard sync to OSC B.",
      "inputs": ["osc_a.pitch_cv", "osc_a.pw_cv", "osc_a.sync_in"],
      "outputs": ["osc_a.out"]
    },
    {
      "id": "osc_b",
      "type": "oscillator",
      "name": "Oscillator B",
      "panel_section": "OSCILLATOR B",
      "scope": "per_voice",
      "description": "VCO with sawtooth, triangle (centred on ground) and/or pulse; FINE (up a semitone); LO FREQ (about 0.4-30 Hz); keyboard control on or off (drone).",
      "properties": {
        "lo_freq_hz": [0.4, 30]
      },
      "inputs": ["osc_b.pitch_cv", "osc_b.pw_cv"],
      "outputs": ["osc_b.out"]
    },
    {
      "id": "noise",
      "type": "noise",
      "name": "White noise",
      "panel_section": "MIXER",
      "scope": "common",
      "description": "White noise source for the voice mixer.",
      "properties": {
        "note": "Whether one source feeds all voices is not stated."
      },
      "inputs": [],
      "outputs": ["noise.out"]
    },
    {
      "id": "mixer",
      "type": "mixer",
      "name": "Mixer",
      "panel_section": "MIXER",
      "scope": "per_voice",
      "description": "OSC A, OSC B and noise levels into the filter; also used to balance program volumes.",
      "inputs": ["mixer.a", "mixer.b", "mixer.noise"],
      "outputs": ["mixer.out"]
    },
    {
      "id": "vcf",
      "type": "filter",
      "name": "Filter",
      "panel_section": "FILTER",
      "scope": "per_voice",
      "description": "Resonant 24 dB/oct (4-pole) low-pass; self-oscillates as a sine above resonance 7; keyboard tracking on or off.",
      "properties": {
        "slope_db_per_oct": 24
      },
      "inputs": ["vcf.in", "vcf.cutoff_cv"],
      "outputs": ["vcf.out"]
    },
    {
      "id": "env_f",
      "type": "envelope",
      "name": "Filter envelope",
      "panel_section": "FILTER",
      "scope": "per_voice",
      "description": "ADSR, about 1 ms-30 s per stage (exponential knob response: 5 is about 0.5 s); also a Poly-Mod source.",
      "properties": {
        "time_s": [0.001, 30]
      },
      "inputs": ["env_f.gate"],
      "outputs": ["env_f.out"]
    },
    {
      "id": "env_a",
      "type": "envelope",
      "name": "Amplifier envelope",
      "panel_section": "AMPLIFIER",
      "scope": "per_voice",
      "description": "ADSR, about 1 ms-30 s per stage.",
      "properties": {
        "time_s": [0.001, 30]
      },
      "inputs": ["env_a.gate"],
      "outputs": ["env_a.out"]
    },
    {
      "id": "vca",
      "type": "vca",
      "name": "VCA",
      "panel_section": "AMPLIFIER",
      "scope": "per_voice",
      "description": "Shapes each voice with the amplifier envelope.",
      "inputs": ["vca.in", "vca.cv"],
      "outputs": ["vca.out"]
    },
    {
      "id": "pmod",
      "type": "modulation_bus",
      "name": "Poly-Mod",
      "panel_section": "POLY-MOD",
      "scope": "per_voice",
      "description": "Per-voice: filter envelope (FILT ENV amount) plus OSC B (OSC B amount) to OSC A frequency, OSC A pulse width and/or filter, by switch. Different in each voice, so effects vary note to note.",
      "inputs": ["pmod.env", "pmod.osc_b"],
      "outputs": ["pmod.out"]
    },
    {
      "id": "lfo",
      "type": "lfo",
      "name": "LFO",
      "panel_section": "LFO",
      "scope": "common",
      "description": "Single LFO, about 0.04-20 Hz, sawtooth, triangle and/or square.",
      "properties": {
        "rate_hz": [0.04, 20]
      },
      "inputs": [],
      "outputs": ["lfo.out"]
    },
    {
      "id": "pink",
      "type": "noise",
      "name": "Pink noise (modulation)",
      "panel_section": "WHEEL-MOD",
      "scope": "common",
      "description": "Pink noise as a Wheel-Mod source.",
      "inputs": [],
      "outputs": ["pink.out"]
    },
    {
      "id": "wmod",
      "type": "modulation_bus",
      "name": "Wheel-Mod",
      "panel_section": "WHEEL-MOD",
      "scope": "common",
      "description": "SOURCE MIX blends LFO (0) and pink noise (10); the mod wheel sets depth; switches send it to OSC A/B frequency, OSC A/B pulse width and the filter, the same for every voice.",
      "inputs": ["wmod.lfo", "wmod.noise", "wmod.wheel"],
      "outputs": ["wmod.out"]
    },
    {
      "id": "out",
      "type": "output",
      "name": "Output",
      "panel_section": "VOLUME / back panel",
      "scope": "common",
      "description": "Five voices summed; VOLUME and the AMPLIFIER CV input set the level.",
      "inputs": ["out.in", "out.cv"],
      "outputs": ["out.audio"]
    },
    {
